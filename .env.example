# Copy this file to .env and fill it in. .env is never committed.

# Claude API key, for writing title options and hooks (console.anthropic.com).
ANTHROPIC_API_KEY=

# Twitch app credentials (needed from Phase 3, for Twitch streamers only).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Discord webhook for phone notifications (Discord: channel settings → Integrations →
# Webhooks → New Webhook → Copy Webhook URL). Treat it like a password.
DISCORD_WEBHOOK_URL=
